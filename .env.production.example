# Copy to .env.production.local for a local check, or set these in your host.
# Never commit real credentials. Use a separate production database.
DATABASE_URL=postgresql://bloom:CHANGE_ME@database.example.com:5432/bloom?schema=public&sslmode=require
SITE_URL=https://bloom.example.com
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
# Enable only after verifying the proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
